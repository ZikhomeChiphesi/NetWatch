DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=netwatch

FLASK_SECRET_KEY=change-me-to-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:5173
SESSION_TTL_HOURS=24
ALLOW_PUBLIC_SIGNUP=false

AGENT_STALE_SECONDS=90
METRICS_TOKEN=change-me
LOG_LEVEL=INFO
PORT=5000

NETWATCH_API_URL=http://127.0.0.1:5000
NETWATCH_NETWORK_NAME=Example_Network
NETWATCH_SCAN_RANGE=192.168.1.0/24
NETWATCH_ENROLLMENT_TOKEN=
NETWATCH_SCAN_INTERVAL=10
NETWATCH_HEARTBEAT_INTERVAL=30
NETWATCH_REQUEST_TIMEOUT=10
NETWATCH_VERIFY_TLS=true